# Copie para .env (na raiz) antes de subir com docker compose.
# Gere segredos fortes:  openssl rand -hex 32

# Conta de administrador (vê todos os clientes). Criada na primeira subida.
# Login: ADMIN_EMAIL · Senha: ADMIN_PASSWORD (se vazio, usa APP_PASSWORD)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
# Senha antiga do painel (continua valendo como senha do admin)
APP_PASSWORD=troque-esta-senha
# Nome do primeiro cliente, que recebe os dados já existentes
DEFAULT_WORKSPACE_NAME=Law Mídias
# 0 = esconde o botão "Criar conta" (só o admin cria clientes)
ALLOW_SIGNUP=1
# Segredo para assinar tokens de login
APP_SECRET=cole-aqui-um-hex-de-32-bytes

# IA (opcional). Em branco = rascunhos de exemplo, sem chamar a Anthropic.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Domínio para o Caddy (HTTPS automático). Sem domínio, deixe :80
# Ex.: DOMAIN=atendimento.seudominio.com.br
DOMAIN=:80

# Copie para .env (na raiz) antes de subir com docker compose.
# Gere segredos fortes:  openssl rand -hex 32

# Senha de acesso ao painel
APP_PASSWORD=troque-esta-senha
# Segredo para assinar tokens de login
APP_SECRET=cole-aqui-um-hex-de-32-bytes

# IA (opcional). Em branco = rascunhos de exemplo, sem chamar a Anthropic.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Domínio para o Caddy (HTTPS automático). Sem domínio, deixe :80
# Ex.: DOMAIN=atendimento.seudominio.com.br
DOMAIN=:80

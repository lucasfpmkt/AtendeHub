// Modelo de dados do LawHub (multi-cliente).
// Cada cliente é um Workspace; todo dado de atendimento tem workspaceId.
// SQLite por padrão; para Postgres troque o provider e a DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Um cliente do LawHub (escritório). Tem o próprio WhatsApp, agentes e CRM.
model Workspace {
  id         String   @id @default(cuid())
  code       Int      @default(0) // número curto exibido (#1001)
  name       String
  plan       String   @default("MENSAL") // MENSAL | CLIENTE | TESTE
  expiresAt  String? // YYYY-MM-DD (vencimento do plano)
  active     Boolean  @default(true)
  legacyAuth Boolean  @default(false) // usa a pasta de sessão WhatsApp antiga
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Pessoa que entra no painel. admin vê todos os clientes; user vê só o seu.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("user") // admin | user
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

/// Um contato do CRM. Criado automaticamente quando chega uma mensagem
/// de um número ainda desconhecido.
model Contact {
  id            String         @id @default(cuid())
  workspaceId String?
  waJid         String
  phone         String
  name          String?
  avatarUrl     String?
  notes         String?
  tags          String         @default("")
  stageId       String?
  stage         PipelineStage? @relation(fields: [stageId], references: [id])
  conversations Conversation[]
  deals         Deal[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, waJid])
  @@index([workspaceId])
}

model Conversation {
  id              String    @id @default(cuid())
  workspaceId String?
  contactId       String
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel         String    @default("whatsapp")
  status          String    @default("open")
  aiEnabled       Boolean   @default(false)
  assignedAgentId String? // agente que está conduzindo a conversa
  unread          Int       @default(0) // mensagens recebidas ainda não lidas pela equipe
  lastMessageAt   DateTime  @default(now())
  messages        Message[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Um agente de IA. Pode ser de triagem (recebe tudo e roteia) ou de tema
/// (conduz o atendimento seguindo seu diretório/roteiro).
model Agent {
  id           String   @id @default(cuid())
  workspaceId String?
  name         String
  type         String   @default("theme") // triage | theme
  description  String   @default("") // tema do agente, usado pela triagem
  script       String   @default("") // o "diretório" / roteiro
  triggers     String   @default("") // palavras-gatilho (CSV)
  regras       String   @default("") // regras gerais de comportamento (tom, o que nunca dizer…)
  faq          String   @default("[]") // JSON: { q, a }[] — dúvidas fora do roteiro
  signatureOn  Boolean  @default(false)
  signature    String   @default("")
  active       Boolean  @default(true)
  delaySeconds Int      @default(15)
  order        Int      @default(0)
  history      AgentHistory[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Quem mudou o quê em cada agente.
model AgentHistory {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())
}

/// Tarefa da equipe.
model Task {
  id          String   @id @default(cuid())
  workspaceId String?
  title       String
  status      String   @default("todo") // todo | doing | done
  priority    String   @default("Média") // Alta | Média | Baixa
  responsavel String?
  dueDate     String? // YYYY-MM-DD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Compromisso da agenda.
model Event {
  id        String   @id @default(cuid())
  workspaceId String?
  title     String
  date      String // YYYY-MM-DD
  start     String // HH:MM
  end       String // HH:MM
  kind      String   @default("meet") // meet (com cliente) | int (interna)
  notes     String?
  createdAt DateTime @default(now())
}

/// Mensagem rápida: digite o atalho (ex.: /docs) no chat.
model QuickReply {
  id        String   @id @default(cuid())
  workspaceId String?
  shortcut  String
  text      String
  createdAt DateTime @default(now())

  @@unique([workspaceId, shortcut])
}

/// Resposta automática por palavra-chave (só em conversas sem IA atendendo).
model KeywordRule {
  id        String   @id @default(cuid())
  workspaceId String?
  keyword   String
  reply     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  author         String
  body           String
  waMessageId    String?
  mediaType      String? // image | video | audio | document | sticker
  mediaId        String? // id do arquivo salvo (usado na URL /api/media/:id)
  mediaName      String? // nome original (documentos)
  mimeType       String?
  createdAt      DateTime     @default(now())
}

/// Um funil de vendas. Pode haver vários (Funil Padrão, Rescisão, etc.).
model Funnel {
  id        String          @id @default(cuid())
  workspaceId String?
  name      String
  order     Int             @default(0)
  stages    PipelineStage[]
  deals     Deal[]
  createdAt DateTime        @default(now())
}

/// Etapa (coluna) de um funil, com cor própria.
model PipelineStage {
  id       String    @id @default(cuid())
  workspaceId String?
  name     String
  color    String    @default("#b71312")
  order    Int       @default(0)
  funnelId String?
  funnel   Funnel?   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contacts Contact[]
  deals    Deal[]
  followupMinutes Int    @default(0) // 0 = sem follow-up automático
  followupMessage String @default("") // mensagem enviada ao ficar parado nesta etapa
}

/// Uma oportunidade/negócio ligada a um contato e a uma etapa de um funil.
model Deal {
  id          String         @id @default(cuid())
  workspaceId String?
  title       String
  valueCents  Int            @default(0)
  source      String? // origem do lead (ex.: WhatsApp, Indicação, Anúncio)
  responsavel String? // responsável pelo atendimento
  tags        String         @default("")
  contactId   String?
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  funnelId    String?
  funnel      Funnel?        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       PipelineStage? @relation(fields: [stageId], references: [id])
  stageSince  DateTime       @default(now()) // quando entrou na etapa atual (base do follow-up)
  followupStageId String?    // etapa cujo follow-up já foi enviado (evita repetir)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// Catálogo de etiquetas coloridas (usadas em contatos e negócios).
model Tag {
  id    String @id @default(cuid())
  workspaceId String?
  name  String
  color String @default("#b71312")

  @@unique([workspaceId, name])
}

/// Configuração do assistente de IA — uma por cliente (id = workspaceId).
model AiConfig {
  id           String  @id @default("default")
  systemPrompt String
  autoReply    Boolean @default(false)
  model        String  @default("claude-haiku-5-5")
  provider     String  @default("anthropic") // anthropic | openai | gemini | deepseek | groq | mistral | xai | openrouter | custom
  apiKey       String  @default("") // chave do provedor escolhido (por cliente)
  baseUrl      String  @default("") // endpoint (só p/ "custom" ou override)
}

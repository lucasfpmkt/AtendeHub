// Modelo de dados do LawHub (multi-cliente).
// Cada cliente é um Workspace; todo dado de atendimento tem workspaceId.
// SQLite por padrão; para Postgres troque o provider e a DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Um cliente do LawHub (escritório). Tem o próprio WhatsApp, agentes e CRM.
model Workspace {
  id         String   @id @default(cuid())
  code       Int      @default(0) // número curto exibido (#1001)
  name       String
  plan       String   @default("MENSAL") // MENSAL | CLIENTE | TESTE
  expiresAt  String? // YYYY-MM-DD (vencimento do plano)
  active     Boolean  @default(true)
  legacyAuth Boolean  @default(false) // usa a pasta de sessão WhatsApp antiga
  importHistory Boolean @default(true) // false = ao reconectar, NÃO puxa o histórico antigo do WhatsApp (só mensagens novas)
  users      User[]
  adminAccess AdminAccess[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Pessoa que entra no painel. admin vê todos os clientes; user vê só o seu.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("user") // admin | user
  isMaster     Boolean   @default(true) // admin master = acesso a todos os clientes (só relevante p/ role=admin)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lastLoginAt  DateTime?
  adminAccess  AdminAccess[]
  createdAt    DateTime  @default(now())
}

/// Um contato do CRM. Criado automaticamente quando chega uma mensagem
/// de um número ainda desconhecido.
model Contact {
  id            String         @id @default(cuid())
  workspaceId String?
  waJid         String
  phone         String
  name          String?
  avatarUrl     String?
  notes         String?
  tags          String         @default("")
  ctwaClid      String         @default("") // id do clique do anúncio (Click-to-WhatsApp)
  stageId       String?
  stage         PipelineStage? @relation(fields: [stageId], references: [id])
  conversations Conversation[]
  deals         Deal[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, waJid])
  @@index([workspaceId])
}

model Conversation {
  id              String    @id @default(cuid())
  workspaceId String?
  // Lead de campanha (anúncio): chegou com uma frase-gatilho cadastrada em algum roteiro de IA.
  campaignSource  String? // "gatilho"
  campaignAd      String? // nome do agente cujo gatilho bateu
  campaignAt      DateTime? // quando o gatilho chegou (a análise usa esta data, não a da conversa)
  contactId       String
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel         String    @default("whatsapp")
  status          String    @default("open")
  aiEnabled       Boolean   @default(false)
  assignedAgentId String? // agente que está conduzindo a conversa
  unread          Int       @default(0) // mensagens recebidas ainda não lidas pela equipe
  lastMessageAt   DateTime  @default(now())
  messages        Message[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Um agente de IA. Pode ser de triagem (recebe tudo e roteia) ou de tema
/// (conduz o atendimento seguindo seu diretório/roteiro).
model Agent {
  id           String   @id @default(cuid())
  workspaceId String?
  name         String
  type         String   @default("theme") // triage | theme
  description  String   @default("") // tema do agente, usado pela triagem
  script       String   @default("") // o "diretório" / roteiro
  triggers     String   @default("") // palavras-gatilho (CSV)
  funnelId     String?  // funil deste agente: "Mudar etapa: X" do roteiro vai pro X deste funil
  regras       String   @default("") // regras gerais de comportamento (tom, o que nunca dizer…)
  faq          String   @default("[]") // JSON: { q, a }[] — dúvidas fora do roteiro
  signatureOn  Boolean  @default(false)
  signature    String   @default("")
  active       Boolean  @default(true)
  delaySeconds Int      @default(15)
  order        Int      @default(0)
  history      AgentHistory[]
  media        AgentMedia[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Mídia da biblioteca de um agente (enviada pelo roteiro: "Enviar mídia: NOME").
model AgentMedia {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name        String // nome usado no roteiro
  kind        String // image | video | audio | document
  mimeType    String
  fileName    String?
  fileId      String // arquivo salvo na pasta de mídia do cliente
  size        Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([agentId])
}

/// Análise automática das campanhas (Meta + Google) com sugestões de otimização.
/// Gerada toda segunda e quarta (ou sob demanda) e exibida em Marketing › Otimizações.
model AdsInsightReport {
  id          String   @id @default(cuid())
  workspaceId String
  trigger     String   @default("auto") // auto | manual
  runDate     String // AAAA-MM-DD no horário de Brasília (evita rodar 2x no mesmo dia)
  status      String   @default("ok") // ok | error
  summary     String   @default("")
  items       String   @default("[]") // JSON: [{ severity, platform, campaign, title, detail, action }]
  platforms   String   @default("") // ex.: "meta,google"
  error       String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

/// Análise de atendimento de um lead de campanha (só o atendimento humano).
model AttendanceReview {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String   @unique
  score          Int      @default(0) // 0 a 10
  verdict        String   @default("") // bom | regular | ruim
  speed          String   @default("") // rapido | ok | lento
  metrics        String   @default("{}") // JSON: tempos de resposta etc.
  summary        String   @default("")
  strengths      String   @default("[]") // JSON string[]
  errors         String   @default("[]")
  missing        String   @default("[]")
  recommendation String   @default("")
  analyzedUntil  DateTime // última mensagem considerada (só reanalisa se houver novas)
  final          Boolean  @default(false) // lead chegou à etapa final: não reanalisa mais
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
}

/// Quem mudou o quê em cada agente.
model AgentHistory {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())
}

/// Tarefa da equipe.
model Task {
  id          String   @id @default(cuid())
  workspaceId String?
  title       String
  status      String   @default("todo") // todo | doing | done
  priority    String   @default("Média") // Alta | Média | Baixa
  responsavel String?
  dueDate     String? // YYYY-MM-DD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Compromisso da agenda.
model Event {
  id        String   @id @default(cuid())
  workspaceId String?
  title     String
  date      String // YYYY-MM-DD
  start     String // HH:MM
  end       String // HH:MM
  kind      String   @default("meet") // meet (com cliente) | int (interna)
  notes     String?
  createdAt DateTime @default(now())
}

/// Mensagem rápida: digite o atalho (ex.: /docs) no chat.
model QuickReply {
  id        String   @id @default(cuid())
  workspaceId String?
  shortcut  String
  text      String
  createdAt DateTime @default(now())

  @@unique([workspaceId, shortcut])
}

/// Resposta automática por palavra-chave (só em conversas sem IA atendendo).
model KeywordRule {
  id        String   @id @default(cuid())
  workspaceId String?
  keyword   String
  reply     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  author         String
  body           String
  waMessageId    String?
  mediaType      String? // image | video | audio | document | sticker
  mediaId        String? // id do arquivo salvo (usado na URL /api/media/:id)
  mediaName      String? // nome original (documentos)
  mimeType       String?
  createdAt      DateTime     @default(now())
}

/// Um funil de vendas. Pode haver vários (Funil Padrão, Rescisão, etc.).
model Funnel {
  id        String          @id @default(cuid())
  workspaceId String?
  name      String
  order     Int             @default(0)
  stages    PipelineStage[]
  deals     Deal[]
  createdAt DateTime        @default(now())
}

/// Etapa (coluna) de um funil, com cor própria.
model PipelineStage {
  id       String    @id @default(cuid())
  workspaceId String?
  name     String
  color    String    @default("#b71312")
  order    Int       @default(0)
  funnelId String?
  funnel   Funnel?   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contacts Contact[]
  deals    Deal[]
  followupMinutes Int    @default(0) // 0 = sem follow-up automático
  followupMessage String @default("") // mensagem enviada ao ficar parado nesta etapa
  autoTag         String @default("") // etiqueta aplicada automaticamente ao lead ao entrar nesta etapa
}

/// Uma oportunidade/negócio ligada a um contato e a uma etapa de um funil.
model Deal {
  id          String         @id @default(cuid())
  workspaceId String?
  title       String
  valueCents  Int            @default(0)
  source      String? // origem do lead (ex.: WhatsApp, Indicação, Anúncio)
  responsavel String? // responsável pelo atendimento
  tags        String         @default("")
  contactId   String?
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  funnelId    String?
  funnel      Funnel?        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       PipelineStage? @relation(fields: [stageId], references: [id])
  stageSince  DateTime       @default(now()) // quando entrou na etapa atual (base do follow-up)
  followupStageId String?    // etapa cujo follow-up já foi enviado (evita repetir)
  qualifiedNotifiedAt DateTime? // quando o escritório foi avisado deste lead qualificado
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// Catálogo de etiquetas coloridas (usadas em contatos e negócios).
model Tag {
  id    String @id @default(cuid())
  workspaceId String?
  name  String
  color String @default("#b71312")

  @@unique([workspaceId, name])
}

/// Configuração do assistente de IA — uma por cliente (id = workspaceId).
model AiConfig {
  id           String  @id @default("default")
  systemPrompt String
  autoReply    Boolean @default(false)
  model        String  @default("claude-haiku-5-5")
  provider     String  @default("anthropic") // anthropic | openai | gemini | deepseek | groq | mistral | xai | openrouter | custom
  apiKey       String  @default("") // chave do provedor escolhido (por cliente)
  baseUrl      String  @default("") // endpoint (só p/ "custom" ou override)
  autoStage    Boolean @default(true) // IA move a etapa do CRM lendo a conversa
  // IA dedicada do CRM (ler conversas e mover/criar etapas). Em branco = usa a dos agentes.
  crmProvider  String  @default("")
  crmApiKey    String  @default("")
  crmBaseUrl   String  @default("")
  crmModel     String  @default("")
  // Notificação de lead qualificado no WhatsApp do próprio escritório.
  notifyQualified Boolean @default(true)
  notifyNumber    String  @default("") // vazio = o próprio número conectado (QR)
  // Análise de atendimento (só leads de campanha, só a partir da ativação).
  attendanceEnabled     Boolean   @default(false)
  attendanceSince       DateTime? // leads que chegaram antes disso não são analisados
  attendanceFinalStages String    @default("") // ids de etapas (CSV): ao chegar nelas, a análise do lead encerra
  attendanceLastRun     String    @default("") // AAAA-MM-DD da última rodada diária
  // Follow-ups automáticos por etapa: só funcionam com a chave ligada.
  followupsEnabled      Boolean   @default(false)
  followupsSince        DateTime? // só leads que entraram na etapa depois de ligar
}

/// Mensagem agendada (lembrete/consulta) para enviar pelo WhatsApp no futuro.
model ScheduledMessage {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String
  body           String
  sendAt         DateTime
  sent           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([sent, sendAt])
}

/// Campanha de disparo em massa (com throttle para evitar bloqueio).
model Campaign {
  id          String   @id @default(cuid())
  workspaceId String
  body        String
  audience    String   @default("all") // descrição legível do público
  total       Int      @default(0)
  sent        Int      @default(0)
  status      String   @default("running") // running | done | error
  createdAt   DateTime @default(now())
}

/// Configuração de IA GLOBAL da plataforma (uma só, controlada pelo admin).
/// Vale para todos os clientes; o cliente não altera.
model PlatformConfig {
  id          String  @id @default("global")
  provider    String  @default("")
  apiKey      String  @default("")
  baseUrl     String  @default("")
  model       String  @default("")
  crmProvider String  @default("")
  crmApiKey   String  @default("")
  crmBaseUrl  String  @default("")
  crmModel    String  @default("")
  autoStage   Boolean @default(true)
  // Chave Gemini usada só para entender mídia (transcrever áudio, ler imagem).
  mediaApiKey String  @default("")
  mediaModel  String  @default("")
  // Google Ads GLOBAL (MCC) — definido pelo admin na aba Clientes. Um para
  // todos; por cliente muda só o Customer ID. (secret/token/refresh cifrados)
  gadsClientId        String @default("")
  gadsClientSecret    String @default("")
  gadsDeveloperToken  String @default("")
  gadsLoginCustomerId String @default("")
  gadsRefreshToken    String @default("")
}


/// Clientes que um administrador NÃO-master pode acessar.
model AdminAccess {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

/// Conexão de WhatsApp por cliente: QR (Baileys) ou API Oficial (Meta Cloud API).
model WaConfig {
  id           String @id // = workspaceId
  channel      String @default("qr") // qr | cloud
  cloudPhoneId String @default("") // Phone Number ID (Meta)
  cloudToken   String @default("") // token permanente (System User)
  cloudVerify  String @default("") // verify token do webhook
  cloudWabaId  String @default("")
}


/// Integração com Meta Ads (Conversions API + resumo da conta) por cliente.
model MetaConfig {
  id               String  @id // = workspaceId
  adAccountId      String  @default("") // act_...
  adAccountName    String  @default("") // nome amigável da conta escolhida
  token            String  @default("") // token (System User manual OU OAuth de usuário)
  pixelId          String  @default("") // dataset/pixel para a Conversions API
  capiEnabled      Boolean @default(false)
  qualifiedStageId String  @default("") // etapa que dispara o evento
  eventName        String  @default("Lead")
  connectedVia     String  @default("") // "oauth" | "manual" | ""
  connectedName    String  @default("") // nome do usuário Meta conectado (OAuth)
  tokenExpiresAt   BigInt? // expiração do token longo (ms epoch), quando OAuth
}

/// Integração com Google Ads por cliente (resumo da conta).
model GoogleAdsConfig {
  id             String @id // = workspaceId
  customerId     String @default("")
  customerName   String @default("")
  developerToken String @default("")
  refreshToken   String @default("")
  clientId       String @default("")
  clientSecret   String @default("")
  connectedVia   String @default("") // "oauth" | "manual" | ""
  connectedEmail String @default("") // conta Google conectada (OAuth)
  // Retorno de conversões (Enhanced Conversions for Leads) na etapa qualificada.
  conversionsEnabled Boolean @default(false)
  qualifiedStageId   String  @default("") // etapa que dispara a conversão
  conversionActionId String  @default("") // id da ação de conversão (upload)
  conversionName     String  @default("") // nome amigável da ação escolhida
}

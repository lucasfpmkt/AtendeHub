# ---- Servidor ----
PORT=3001
# URL do frontend autorizada no CORS (em dev)
CLIENT_ORIGIN=http://localhost:5173
# Quando "1", o backend serve o frontend compilado (produção/Docker).
SERVE_CLIENT=0

# ---- Acesso (login) ----
# Senha única de acesso ao painel. TROQUE em produção.
APP_PASSWORD=admin
# Segredo para assinar os tokens. Gere um aleatório: openssl rand -hex 32
APP_SECRET=dev-secret-troque-em-producao

# ---- Banco (Prisma) ----
# SQLite por padrão (zero setup). Para Postgres, troque por:
# DATABASE_URL="postgresql://user:pass@localhost:5432/atendehub"
DATABASE_URL="file:./dev.db"

# ---- IA ----
# Deixe em branco para rodar com respostas-stub (sem chamar nenhum provedor).
# Com chave, o serviço de IA passa a gerar rascunhos/auto-respostas de verdade.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Instrução base do assistente de atendimento (editável também pela UI).
AI_SYSTEM_PROMPT=Você é um assistente de atendimento ao cliente educado, objetivo e em português do Brasil.

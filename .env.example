# ---- Servidor ----
PORT=3001
# URL do frontend autorizada no CORS (em dev)
CLIENT_ORIGIN=http://localhost:5173
# Quando "1", o backend serve o frontend compilado (produção/Docker).
SERVE_CLIENT=0

# ---- Acesso (login) ----
# Senha única de acesso ao painel. TROQUE em produção.
APP_PASSWORD=admin
# Administrador (vê todos os clientes). Senha vazia = usa APP_PASSWORD.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
# Nome do primeiro cliente (recebe os dados já existentes)
DEFAULT_WORKSPACE_NAME=Law Mídias
# 0 = esconde o botão Criar conta
ALLOW_SIGNUP=1
# Segredo para assinar os tokens. Gere um aleatório: openssl rand -hex 32
APP_SECRET=dev-secret-troque-em-producao

# ---- Banco (Prisma) ----
# SQLite por padrão (zero setup). Para Postgres, troque por:
# DATABASE_URL="postgresql://user:pass@localhost:5432/atendehub"
DATABASE_URL="file:./dev.db"

# ---- Meta Ads (login direto / OAuth) ----
# App do Meta (developers.facebook.com → Facebook Login). Com os dois
# preenchidos, aparece o botão "Entrar com o Meta": o cliente só faz login e
# o LawHub puxa a conta de anúncios e os dados — sem colar token.
# Um único app serve todos os clientes. Sem isso, cai no modo manual (token).
FB_APP_ID=
FB_APP_SECRET=
# Versão da Graph API (padrão v21.0).
GRAPH_VERSION=v21.0
# URL pública do app (ex.: https://lawhub.seudominio.com). Se vazio, é
# derivada do próprio request. O redirect do OAuth é <PUBLIC_URL>/api/ads/meta/callback
# — cadastre essa URL em "Valid OAuth Redirect URIs" no painel do app Meta.
PUBLIC_URL=

# ---- Google Ads (login direto / OAuth) ----
# App OAuth do LawHub (console.cloud.google.com → Credenciais → OAuth client
# "Web"). Um só serve todos os clientes. Com os dois, aparece o botão
# "Entrar com o Google" (o cliente só faz login, sem colar refresh token).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Developer token da conta gerenciadora (MCC) do Google Ads — exigido para LER
# os dados (o login funciona sem ele, mas o resumo fica pendente).
GOOGLE_ADS_DEVELOPER_TOKEN=
# ID da conta MCC (login-customer-id), só dígitos, se a conta for gerenciada.
GOOGLE_LOGIN_CUSTOMER_ID=
# Refresh token GLOBAL da MCC (gerado uma vez no OAuth Playground com o escopo
# adwords). Com ele + developer token + login-customer-id definidos, todos os
# clientes usam a mesma credencial e você só escolhe o Customer ID de cada um.
GOOGLE_REFRESH_TOKEN=
# Versão da API do Google Ads (padrão v17).
GOOGLE_ADS_VERSION=v17
# Redirect do OAuth: <PUBLIC_URL>/api/ads/google/callback — cadastre essa URL
# em "Authorized redirect URIs" no OAuth client do Google.

# ---- IA ----
# Deixe em branco para rodar com respostas-stub (sem chamar nenhum provedor).
# Com chave, o serviço de IA passa a gerar rascunhos/auto-respostas de verdade.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Instrução base do assistente de atendimento (editável também pela UI).
AI_SYSTEM_PROMPT=Você é um assistente de atendimento ao cliente educado, objetivo e em português do Brasil.
